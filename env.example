# Copy to .env.local — see design-system/sdot/notion-intake-setup.md

# Notion (primary)
# Personal access token: https://www.notion.so/developers/tokens
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Optional — resolved automatically from the database if omitted
# NOTION_DATA_SOURCE_ID=

# Optional (default 2026-03-11 per Notion API quickstart)
# NOTION_API_VERSION=2026-03-11

# Google Sheets fallback (Apps Script web app URL)
# Used when Notion write fails. Script: scripts/internship-apps-script.js
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# GOOGLE_SHEETS_WEBHOOK_SECRET=